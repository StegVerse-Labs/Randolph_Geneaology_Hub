@@ -0,0 +1,192 @@
+#!/usr/bin/env python3
+"""Close a StegBrowser InTr lifecycle: write the last receipt of the transition.
+
+The lane already produced two receipts and stopped: ingress admitted the
+request, the consumer reported ``MATERIALIZATION_EXECUTION_ATTEMPTED``.
+Attempted is not recorded, so no Master Records custody receipt existed and no
+reconstruction was ever verified. This worker calls the canonical closure
+implementation in continuity-vault-kit and persists what it returns.
+
+The closure logic is not reimplemented here. It lives in
+``runtime/intr_lifecycle_closure.py`` in continuity-vault-kit and is loaded
+from the current KV source root, the same way the Workspace DEVICE_KV
+extension loads ``runtime/workspace_projection.py``. One implementation, so
+the two InTr clients cannot drift apart.
+
+This worker records. It does not execute, does not allocate, and cannot grant
+execution authority or mint a claim or fence.
+"""
+
+from __future__ import annotations
+
+import argparse
+import importlib.machinery
+import importlib.util
+import json
+import os
+import sys
+from pathlib import Path
+from typing import Any
+
+ROOT = Path(__file__).resolve().parents[1]
+
+OUTBOX_DIR_REL = Path("intr-materialization-outbox")
+INGRESS_DIR_REL = Path("receipts/sovereign-network/stegbrowser-intr-ingress")
+CONSUMPTION_DIR_REL = Path("receipts/sovereign-host/stegbrowser-intr-materialization")
+TERMINAL_DIR_REL = Path("receipts/sovereign-network/stegbrowser-intr-lifecycle")
+OBSERVATION_DIR_REL = Path("receipts/sovereign-network/stegbrowser-intr-observation")
+CUSTODY_DIR_REL = Path("workloads/master-records/orchestration/custody/intr-lifecycle")
+
+KV_SOURCE_ROOT_ENV = "STEGVERSE_KV_SOURCE_ROOT"
+KV_REPO_NAME = "continuity-vault-kit"
+CLOSURE_REL = "runtime/intr_lifecycle_closure.py"
+
+
+def kv_source_root() -> Path:
+    """Resolve the continuity-vault-kit source root, repository convention."""
+    candidates: list[Path] = []
+    if os.environ.get(KV_SOURCE_ROOT_ENV):
+        candidates.append(Path(os.environ[KV_SOURCE_ROOT_ENV]).expanduser())
+    try:
+        roots = json.loads(os.environ.get("STEGVERSE_REPO_ROOTS_JSON", "") or "{}")
+    except Exception:
+        roots = {}
+    if isinstance(roots, dict):
+        for key in (f"StegVerse-Labs/{KV_REPO_NAME}", f"StegVerse-org/{KV_REPO_NAME}", KV_REPO_NAME):
+            value = roots.get(key)
+            if isinstance(value, str) and value.strip():
+                candidates.append(Path(value).expanduser())
+    candidates += [ROOT.parent / KV_REPO_NAME, ROOT / KV_REPO_NAME, ROOT.parent.parent / KV_REPO_NAME]
+    for candidate in candidates:
+        resolved = candidate.resolve()
+        if (resolved / CLOSURE_REL).is_file():
+            return resolved
+    raise SystemExit(
+        "FAIL_CLOSED: continuity-vault-kit source root with "
+        + CLOSURE_REL
+        + " not found; set "
+        + KV_SOURCE_ROOT_ENV
+    )
+
+
+#: Synthetic package name for the loaded KV runtime. The closure module uses
+#: package-relative imports, and this repository has its own ``runtime``
+#: directory, so binding the KV package under a distinct name keeps the two
+#: from colliding on ``sys.modules``.
+KV_RUNTIME_PACKAGE = "stegverse_kv_runtime"
+
+
+def load_closure(source_root: Path):
+    """Import the canonical closure module from the resolved KV source root."""
+    runtime_dir = source_root / "runtime"
+    if not runtime_dir.is_dir():
+        raise SystemExit("FAIL_CLOSED: KV runtime package directory missing")
+
+    package = importlib.util.module_from_spec(
+        importlib.machinery.ModuleSpec(KV_RUNTIME_PACKAGE, None, is_package=True)
+    )
+    package.__path__ = [str(runtime_dir)]
+    sys.modules[KV_RUNTIME_PACKAGE] = package
+
+    module_name = f"{KV_RUNTIME_PACKAGE}.intr_lifecycle_closure"
+    spec = importlib.util.spec_from_file_location(module_name, source_root / CLOSURE_REL)
+    if spec is None or spec.loader is None:
+        raise SystemExit("FAIL_CLOSED: closure module could not be loaded")
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[module_name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+def load_json(path: Path, stage: str) -> dict[str, Any]:
+    if not path.is_file():
+        raise SystemExit(f"FAIL_CLOSED: {stage} evidence missing: {path}")
+    value = json.loads(path.read_text(encoding="utf-8"))
+    if not isinstance(value, dict):
+        raise SystemExit(f"FAIL_CLOSED: {stage} evidence is not an object: {path}")
+    return value
+
+
+def write_once(path: Path, value: Any) -> Path:
+    """Write, or accept an identical existing artifact. Never overwrite."""
+    raw = json.dumps(value, sort_keys=True, indent=2).encode("utf-8") + b"\n"
+    if path.exists():
+        if path.read_bytes() != raw:
+            raise SystemExit(f"FAIL_CLOSED: write-once collision: {path}")
+        return path
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_bytes(raw)
+    return path
+
+
+def close(runtime_root: Path, materialization_id: str, *, source_commit: str) -> dict[str, Any]:
+    closure = load_closure(kv_source_root())
+    outbox = load_json(runtime_root / OUTBOX_DIR_REL / f"{materialization_id}.json", "node outbox entry")
+    ingress = load_json(runtime_root / INGRESS_DIR_REL / f"{materialization_id}.json", "ingress receipt")
+    materialization = load_json(
+        runtime_root / CONSUMPTION_DIR_REL / f"{materialization_id}.json", "materialization receipt"
+    )
+
+    try:
+        result = closure.close_lifecycle(
+            outbox_entry=outbox,
+            ingress_receipt=ingress,
+            materialization_receipt=materialization,
+            source_commit=source_commit,
+        )
+    except Exception as exc:
+        # A lifecycle that cannot close names the stage that broke it.
+        return {
+            "schema": "stegverse.stegbrowser-intr-lifecycle-closure-attempt/v1",
+            "state": "LIFECYCLE_NOT_CLOSED",
+            "materialization_id": materialization_id,
+            "reason": f"{type(exc).__name__}:{exc}",
+            "authority_effect": "NONE_FAIL_CLOSED",
+        }
+
+    receipt = result["terminal_receipt"]
+    record = result["master_records_custody_record"]
+    observation = result["far_end_observation"]
+
+    terminal_path = write_once(runtime_root / TERMINAL_DIR_REL / f"{materialization_id}.json", receipt)
+    custody_path = write_once(runtime_root / CUSTODY_DIR_REL / f"{record['custody_id']}.json", record)
+    observation_path = write_once(
+        runtime_root / OBSERVATION_DIR_REL / f"{materialization_id}.json", observation
+    )
+
+    return {
+        "schema": "stegverse.stegbrowser-intr-lifecycle-closure-attempt/v1",
+        "state": "LIFECYCLE_RECORDED",
+        "materialization_id": materialization_id,
+        "terminal_receipt_id": receipt["manifest_receipt_id"],
+        "terminal_receipt_ref": str(terminal_path.relative_to(runtime_root)),
+        "master_records_ref": str(custody_path.relative_to(runtime_root)),
+        "master_records_record_hash": record["record_hash"],
+        "far_end_observation_ref": str(observation_path.relative_to(runtime_root)),
+        "receiver_receipt_observed": observation["receiver_receipt_observed"],
+        "runtime_materialization_observed": observation["runtime_materialization_observed"],
+        "closure_grants_execution_authority": False,
+        "claim_or_fence_minted": False,
+        "credential_authority": "TV/TVC",
+        "github_token_runtime_authority": "NONE",
+        "authority_effect": "NONE_RECORDING_ONLY",
+    }
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description="Close a StegBrowser InTr lifecycle.")
+    parser.add_argument("--runtime-root", type=Path, required=True)
+    parser.add_argument("--materialization-id", required=True)
+    parser.add_argument("--source-commit", default="UNPINNED")
+    args = parser.parse_args()
+    result = close(
+        args.runtime_root.expanduser().resolve(),
+        args.materialization_id,
+        source_commit=args.source_commit,
+    )
+    print(json.dumps(result, indent=2, sort_keys=True))
+    return 0 if result["state"] == "LIFECYCLE_RECORDED" else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
