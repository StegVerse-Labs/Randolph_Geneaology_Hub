@@ -0,0 +1,175 @@
+"""StegBrowser InTr lifecycle closure wiring.
+
+The far end admitted a request, ran a consumer, and stopped at
+MATERIALIZATION_EXECUTION_ATTEMPTED. These tests cover the two changes that
+let the lifecycle actually close: retaining the admitted outbox entry so stage
+one can be reconstructed from stored evidence, and calling the canonical
+closure implementation in continuity-vault-kit.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import importlib.util
+import json
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+if str(ROOT) not in sys.path:
+    sys.path.insert(0, str(ROOT))
+
+_SPEC = importlib.util.spec_from_file_location(
+    "close_stegbrowser_intr_lifecycle_under_test",
+    ROOT / "workers" / "close_stegbrowser_intr_lifecycle.py",
+)
+worker = importlib.util.module_from_spec(_SPEC)
+sys.modules[_SPEC.name] = worker
+_SPEC.loader.exec_module(worker)
+
+MATERIALIZATION_ID = "MR-STEGBROWSER-CUSTODY-0123456789abcdef01234567"
+
+
+def sha_uri(value: object) -> str:
+    raw = json.dumps(value, sort_keys=True, separators=(",", ":"), ensure_ascii=False).encode("utf-8")
+    return "sha256:" + hashlib.sha256(raw).hexdigest()
+
+
+def outbox_entry(**overrides: object) -> dict:
+    entry = {
+        "schema": "stegos.node_intr_outbox_entry.v1",
+        "state": "LOCAL_OUTBOX_PENDING_NETWORK_DELIVERY",
+        "materialization_id": MATERIALIZATION_ID,
+        "node_id": "stegnode-web-2d6daa94e496d451d16bd5619bd30a25",
+        "interlock_id": "SV-IL-300325da3411909dfa04678b",
+        "network_delivery_observed": False,
+        "runtime_materialization_observed": False,
+        "receiver_receipt_observed": False,
+        "tvc_receipt_observed": False,
+        "request_grants_execution_authority": False,
+        "claim_or_fence_minted": False,
+        "credential_authority": "TV/TVC",
+        "github_token_runtime_authority": "NONE",
+        "authority_effect": "NONE_LOCAL_CONTINUITY_ONLY",
+    }
+    entry.update(overrides)
+    entry["outbox_entry_hash"] = sha_uri(entry)
+    return entry
+
+
+def kv_source_available() -> bool:
+    try:
+        worker.kv_source_root()
+    except SystemExit:
+        return False
+    return True
+
+
+class LifecycleClosureWiring(unittest.TestCase):
+    def setUp(self) -> None:
+        if not kv_source_available():
+            self.skipTest("continuity-vault-kit source root not present")
+        self.runtime = Path(tempfile.mkdtemp())
+        entry = outbox_entry()
+        self.entry = entry
+        self._write(worker.OUTBOX_DIR_REL, entry)
+        self._write(
+            worker.INGRESS_DIR_REL,
+            {
+                "schema": "stegverse.stegbrowser-intr-materialization-ingress/v1",
+                "state": "INGRESS_ADMITTED",
+                "materialization_id": MATERIALIZATION_ID,
+                "outbox_entry_hash": entry["outbox_entry_hash"],
+                "queue_ref": f"intr-materialization/{MATERIALIZATION_ID}.json",
+                "claim_or_fence_minted": False,
+                "credential_authority": "TV/TVC",
+                "authority_effect": "NONE_INGRESS_ONLY",
+            },
+        )
+        self._write(
+            worker.CONSUMPTION_DIR_REL,
+            {
+                "schema": "stegverse.stegbrowser-intr-materialization-consumption/v1",
+                "state": "MATERIALIZATION_EXECUTION_ATTEMPTED",
+                "materialization_id": MATERIALIZATION_ID,
+                "execution_returncode": 0,
+                "claim_or_fence_minted": False,
+                "credential_authority": "TV/TVC",
+                "authority_effect": "NONE_CONSUMPTION_ONLY",
+            },
+        )
+
+    def _write(self, rel: Path, value: dict) -> Path:
+        path = self.runtime / rel / f"{MATERIALIZATION_ID}.json"
+        path.parent.mkdir(parents=True, exist_ok=True)
+        path.write_text(json.dumps(value, indent=2, sort_keys=True) + "\n", encoding="utf-8")
+        return path
+
+    def close(self) -> dict:
+        return worker.close(self.runtime, MATERIALIZATION_ID, source_commit="TESTCOMMIT")
+
+    def test_lifecycle_records_and_writes_all_three_artifacts(self) -> None:
+        result = self.close()
+        self.assertEqual(result["state"], "LIFECYCLE_RECORDED")
+        for key in ("terminal_receipt_ref", "master_records_ref", "far_end_observation_ref"):
+            self.assertTrue((self.runtime / result[key]).is_file(), key)
+
+    def test_the_flags_nothing_could_previously_set_are_now_answered(self) -> None:
+        result = self.close()
+        self.assertTrue(result["receiver_receipt_observed"])
+        self.assertTrue(result["runtime_materialization_observed"])
+
+    def test_closure_grants_no_authority(self) -> None:
+        result = self.close()
+        self.assertFalse(result["closure_grants_execution_authority"])
+        self.assertFalse(result["claim_or_fence_minted"])
+        self.assertEqual(result["authority_effect"], "NONE_RECORDING_ONLY")
+        self.assertEqual(result["github_token_runtime_authority"], "NONE")
+
+    def test_master_records_custody_record_is_written_under_orchestration(self) -> None:
+        result = self.close()
+        self.assertTrue(
+            result["master_records_ref"].startswith(
+                "workloads/master-records/orchestration/custody/intr-lifecycle/"
+            )
+        )
+        record = json.loads((self.runtime / result["master_records_ref"]).read_text(encoding="utf-8"))
+        self.assertEqual(record["custody"]["status"], "ACCEPTED_FOR_CUSTODY")
+        self.assertEqual(record["record_hash"], result["master_records_record_hash"])
+
+    def test_closure_is_write_once_and_idempotent(self) -> None:
+        first = self.close()
+        second = self.close()
+        self.assertEqual(first["terminal_receipt_id"], second["terminal_receipt_id"])
+
+    def test_tampered_retained_entry_is_refused_naming_the_stage(self) -> None:
+        self._write(worker.OUTBOX_DIR_REL, {**self.entry, "node_id": "stegnode-web-tampered"})
+        result = self.close()
+        self.assertEqual(result["state"], "LIFECYCLE_NOT_CLOSED")
+        self.assertIn("NODE_OUTBOX_ENTRY_WRITTEN", result["reason"])
+        self.assertEqual(result["authority_effect"], "NONE_FAIL_CLOSED")
+
+    def test_missing_stage_evidence_fails_closed(self) -> None:
+        (self.runtime / worker.CONSUMPTION_DIR_REL / f"{MATERIALIZATION_ID}.json").unlink()
+        with self.assertRaises(SystemExit):
+            self.close()
+
+
+class IngressRetainsAdmittedEntry(unittest.TestCase):
+    """Validating a digest and discarding the artifact is why stage one could
+    never be reconstructed."""
+
+    def test_ingress_persists_the_outbox_entry_write_once(self) -> None:
+        source = (ROOT / "workers" / "stegbrowser_intr_materialization_ingress.py").read_text(
+            encoding="utf-8"
+        )
+        self.assertIn("OUTBOX_DIR_REL", source)
+        self.assertIn('"node_outbox_entry": dict(entry)', source)
+        self.assertIn("hil._write_once(outbox_path, outbox_raw)", source)
+        self.assertIn('"outbox_entry_ref": str(outbox_path)', source)
+
+
+if __name__ == "__main__":
+    unittest.main()
