@@ -0,0 +1,613 @@
+#!/usr/bin/env python3
+"""Admit a device/resident organization allocator transition receipt at org level.
+
+The canonical allocator (``scripts/allocate_claims.py`` and its portable
+projection ``org_allocator/portable_allocator.js``) already computes claim
+state transitions on three surfaces:
+
+* the tokenless CI runner, whose mutations are discarded by design
+  (``org-control-plane-validate.yml`` runs the allocator as validation
+  evidence and never commits),
+* a resident host runtime root via
+  ``scripts/consume_org_claim_allocator_request.py``, which persists into
+  *that* runtime and not into this repository,
+* the current user's device, which persists into a hash-chained node
+  journal.
+
+Nothing carried any of those transitions back into this repository. The
+consequence is observable: ``control/claims-active.json`` sits at generation
+2 with zero claims, so ``heartbeat_runtime.org_assertions`` issues nothing,
+so all 26 ``organization_assertions_issued`` events in
+``events/heartbeat-runtime.jsonl`` carry ``issued_count: 0``, so no
+organization event and no Master Records record was ever produced.
+
+This module is the missing recorder. It does not allocate and it cannot
+create claim authority: it only admits a receipt the canonical allocator
+already signed, and it fails closed on anything it cannot verify.
+
+Denial is a first-class result. A receipt whose generation runs ahead of the
+recorded generation is refused with the exact list of transitions that must
+be supplied first, because inventing the intervening receipts would
+manufacture organization state that no allocator ever produced.
+"""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import re
+from datetime import datetime, timezone
+from pathlib import Path
+from typing import Any, Iterable, Mapping
+
+ROOT = Path(__file__).resolve().parents[1]
+
+RECEIPT_SCHEMA = "stegverse.org-allocator-portable-receipt/v1"
+OBSERVATION_SCHEMA = "stegverse.org-claim-grant-observation/v1"
+ADMISSION_SCHEMA = "stegverse.org-allocator-transition-admission/v1"
+CUSTODY_SCHEMA = "stegverse.org_allocation_custody.v1"
+
+CLAIMS_REL = Path("control/claims-active.json")
+QUEUE_REL = Path("control/queue.json")
+EVENTS_REL = Path("events/org-events.jsonl")
+TASKS_REL = Path("tasks")
+CUSTODY_REL = Path("workloads/master-records/orchestration/custody/org-allocation")
+
+#: Assertions the canonical allocator stamps on every receipt. A receipt that
+#: disagrees with any of them is not a canonical allocator receipt.
+REQUIRED_ASSERTIONS: Mapping[str, Any] = {
+    "canonical_authority_owner": "StegVerse-Labs/.github organization allocator",
+    "credential_authority": "TV/TVC",
+    "github_token_runtime_authority": "NONE",
+    "heartbeat_grants_claim_authority": False,
+    "request_grants_claim_authority": False,
+    "stegos_grants_claim_authority": False,
+    "network_source_fetch_performed": False,
+    "requires_other_machine": False,
+    "second_user_operated_device_required": False,
+}
+
+#: Field-name substrings that must not appear in an admitted receipt.
+SECRET_TOKENS = ("password", "secret", "private_key", "access_key", "api_key", "cookie")
+
+#: Exact names that carry a substring above but are governance assertions.
+#: Same policy shape as continuity-vault-kit ``runtime/secret_field_policy``:
+#: an allow-listed name is admitted only when its value also looks like an
+#: assertion, so the allow-list cannot become a smuggling channel.
+ASSERTION_FIELDS = frozenset(
+    {
+        "credential_authority",
+        "contains_secret_material",
+        "secret_plaintext_present",
+        "github_token_required",
+        "github_token_runtime_authority",
+    }
+)
+MAX_ASSERTION_STRING = 200
+_BLOB = re.compile(r"[A-Za-z0-9+/=_-]{32,}")
+
+
+def canonical(value: Any) -> bytes:
+    """Byte-identical to ``canonicalize`` in org_allocator/portable_allocator.js."""
+    return json.dumps(
+        value, sort_keys=True, separators=(",", ":"), ensure_ascii=False, allow_nan=False
+    ).encode("utf-8")
+
+
+def sha256_hex(value: Any) -> str:
+    return hashlib.sha256(canonical(value)).hexdigest()
+
+
+def load_json(path: Path) -> Any:
+    return json.loads(path.read_text(encoding="utf-8"))
+
+
+def dump_json(path: Path, value: Any) -> None:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(json.dumps(value, indent=2, sort_keys=True) + "\n", encoding="utf-8")
+
+
+def value_is_assertion_like(value: Any) -> bool:
+    if isinstance(value, bool) or value is None:
+        return True
+    if isinstance(value, int):
+        return True
+    if isinstance(value, str):
+        return len(value) <= MAX_ASSERTION_STRING and not _BLOB.search(value)
+    return False
+
+
+def find_forbidden_field(value: Any, path: str = "receipt") -> str | None:
+    """Return the dotted path of the first secret-bearing field, or None."""
+    if isinstance(value, Mapping):
+        for key, child in value.items():
+            name = str(key)
+            allowed = name in ASSERTION_FIELDS and value_is_assertion_like(child)
+            if not allowed and any(token in name.lower() for token in SECRET_TOKENS):
+                return f"{path}.{name}"
+            nested = find_forbidden_field(child, f"{path}.{name}")
+            if nested is not None:
+                return nested
+    elif isinstance(value, (list, tuple)):
+        for index, child in enumerate(value):
+            nested = find_forbidden_field(child, f"{path}[{index}]")
+            if nested is not None:
+                return nested
+    return None
+
+
+# --------------------------------------------------------------------------
+# unwrapping
+# --------------------------------------------------------------------------
+
+
+def extract(document: Any) -> dict[str, Any]:
+    """Locate the allocator receipt inside any of the shapes it is carried in.
+
+    Receipts reach this repository wrapped: as a bare receipt, inside a node
+    journal entry, or inside a recovered-evidence envelope. Provenance found
+    alongside the receipt is retained, because it is what ties an admitted
+    organization transition back to the device that produced it.
+    """
+    if not isinstance(document, Mapping):
+        raise ValueError("receipt document must be a JSON object")
+
+    receipt: Any = None
+    observation: Any = None
+    provenance: dict[str, Any] = {}
+
+    def walk(node: Any) -> None:
+        nonlocal receipt, observation
+        if isinstance(node, Mapping):
+            schema = node.get("schema")
+            if schema == RECEIPT_SCHEMA and receipt is None:
+                receipt = node
+            elif schema == OBSERVATION_SCHEMA and observation is None:
+                observation = node
+            for key in (
+                "node_id",
+                "device_continuity_id",
+                "execution_surface",
+                "execution_trigger",
+                "allocator_release",
+                "executed_at",
+                "entry_sha256",
+                "sequence",
+                "previous_entry_sha256",
+            ):
+                if key in node and key not in provenance and not isinstance(node[key], (dict, list)):
+                    provenance[key] = node[key]
+            for child in node.values():
+                walk(child)
+        elif isinstance(node, list):
+            for child in node:
+                walk(child)
+
+    walk(document)
+    if receipt is None:
+        raise ValueError(f"no {RECEIPT_SCHEMA} found in document")
+    return {"receipt": dict(receipt), "observation": observation, "provenance": provenance}
+
+
+# --------------------------------------------------------------------------
+# verification
+# --------------------------------------------------------------------------
+
+
+def deny(reason: str, **detail: Any) -> dict[str, Any]:
+    return {"decision": "DENY", "deny_reason": reason, **detail}
+
+
+def recorded_generation(root: Path) -> int:
+    claims = load_json(root / CLAIMS_REL)
+    generation = claims.get("generation")
+    if not isinstance(generation, int) or isinstance(generation, bool) or generation < 0:
+        raise ValueError("recorded claim registry generation invalid")
+    return generation
+
+
+def admitted_receipt_digests(root: Path) -> set[str]:
+    path = root / EVENTS_REL
+    if not path.is_file():
+        return set()
+    digests: set[str] = set()
+    for line in path.read_text(encoding="utf-8").splitlines():
+        line = line.strip()
+        if not line:
+            continue
+        try:
+            event = json.loads(line)
+        except ValueError:
+            continue
+        digest = event.get("receipt_sha256")
+        if isinstance(digest, str):
+            digests.add(digest)
+    return digests
+
+
+def evaluate(root: Path, document: Any) -> dict[str, Any]:
+    """Decide whether one receipt may be recorded as organization state.
+
+    Every refusal names the transition that is missing or wrong rather than
+    reporting a bare failure, so a denied receipt says what to fetch next.
+    """
+    parts = extract(document)
+    receipt = parts["receipt"]
+    observation = parts["observation"]
+
+    if receipt.get("state") != "ALLOCATION_COMPLETE":
+        return deny("RECEIPT_STATE_NOT_ALLOCATION_COMPLETE", observed_state=receipt.get("state"))
+
+    supplied = receipt.get("receipt_sha256")
+    if not isinstance(supplied, str) or not supplied.startswith("sha256:"):
+        return deny("RECEIPT_DIGEST_MISSING")
+    body = {key: value for key, value in receipt.items() if key != "receipt_sha256"}
+    recomputed = "sha256:" + sha256_hex(body)
+    if recomputed != supplied:
+        return deny("RECEIPT_DIGEST_MISMATCH", recomputed=recomputed, supplied=supplied)
+
+    for field, expected in REQUIRED_ASSERTIONS.items():
+        if receipt.get(field) != expected:
+            return deny(
+                "GOVERNANCE_ASSERTION_MISMATCH",
+                field=field,
+                expected=expected,
+                observed=receipt.get(field),
+            )
+
+    forbidden = find_forbidden_field(receipt)
+    if forbidden is not None:
+        return deny("SECRET_BEARING_FIELD", field_path=forbidden)
+
+    selected = receipt.get("selected")
+    if not isinstance(selected, str) or not selected:
+        return deny("RECEIPT_SELECTED_NO_TASK")
+
+    granted = receipt.get("granted_claims")
+    if not isinstance(granted, list) or not granted:
+        return deny("RECEIPT_GRANTED_CLAIMS_EMPTY")
+
+    generation = receipt.get("claim_registry_generation")
+    if not isinstance(generation, int) or isinstance(generation, bool) or generation < 1:
+        return deny("RECEIPT_GENERATION_INVALID", observed=generation)
+
+    fences: list[int] = []
+    for claim in granted:
+        if not isinstance(claim, Mapping):
+            return deny("RECEIPT_GRANTED_CLAIM_NOT_OBJECT")
+        if claim.get("task_id") != selected:
+            return deny("RECEIPT_GRANTED_CLAIM_TASK_MISMATCH", observed=claim.get("task_id"))
+        fence = (claim.get("lease") or {}).get("fencing_token")
+        if not isinstance(fence, int) or isinstance(fence, bool) or fence < 1:
+            return deny("RECEIPT_FENCING_TOKEN_INVALID", observed=fence)
+        if fence != generation:
+            return deny(
+                "RECEIPT_FENCE_GENERATION_DISAGREE", fencing_token=fence, generation=generation
+            )
+        fences.append(fence)
+
+    if observation is not None:
+        snapshot = {
+            "task_id": selected,
+            "claim_registry_generation": generation,
+            "claims": granted,
+        }
+        if observation.get("claim_snapshot_sha256") != sha256_hex(snapshot):
+            return deny("CLAIM_SNAPSHOT_DIGEST_MISMATCH")
+
+    task_path = root / TASKS_REL / f"{selected}.json"
+    if not task_path.is_file():
+        return deny("TASK_NOT_IN_CATALOG", task_id=selected)
+
+    if supplied in admitted_receipt_digests(root):
+        return {
+            "decision": "ALREADY_ADMITTED",
+            "task_id": selected,
+            "claim_registry_generation": generation,
+            "receipt_sha256": supplied,
+        }
+
+    current = recorded_generation(root)
+    if generation <= current:
+        return deny(
+            "GENERATION_NOT_MONOTONIC",
+            recorded_generation=current,
+            receipt_generation=generation,
+        )
+    if generation > current + 1:
+        missing = list(range(current + 1, generation))
+        return deny(
+            "GENERATION_GAP",
+            recorded_generation=current,
+            receipt_generation=generation,
+            missing_generations=missing,
+            remedy=(
+                "supply the canonical allocator receipts for generations "
+                + ",".join(str(value) for value in missing)
+                + " before this one; they exist only on the surface that produced them"
+            ),
+        )
+
+    return {
+        "decision": "ADMIT",
+        "task_id": selected,
+        "claim_registry_generation": generation,
+        "recorded_generation": current,
+        "receipt_sha256": supplied,
+        "fencing_tokens": sorted(fences),
+        "granted_claims": granted,
+        "queued": receipt.get("queued") or [],
+        "blocked_missing_dependency_declaration": receipt.get(
+            "blocked_missing_dependency_declaration"
+        )
+        or [],
+        "execution_surface": receipt.get("execution_surface"),
+        "provenance": parts["provenance"],
+        "observation_present": observation is not None,
+    }
+
+
+# --------------------------------------------------------------------------
+# recording
+# --------------------------------------------------------------------------
+
+
+def dependency_surfaces(claims: Iterable[Mapping[str, Any]]) -> list[str]:
+    found: set[str] = set()
+    for claim in claims:
+        for value in ((claim.get("scope") or {}).get("dependency_surfaces") or []):
+            text = str(value).strip()
+            if text:
+                found.add(text)
+    return sorted(found)
+
+
+def occurred_at(decision: Mapping[str, Any]) -> str:
+    stamp = decision.get("provenance", {}).get("executed_at")
+    if isinstance(stamp, str) and stamp:
+        return stamp
+    return datetime.now(timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")
+
+
+def custody_record(decision: Mapping[str, Any], *, source_commit: str) -> dict[str, Any]:
+    """Project an admitted transition into the Master Records custody shape.
+
+    Section layout follows the one custody record this repository already
+    holds (``stegverse.worker_lifecycle_custody.v2``): source, claim,
+    validation, custody, boundaries, record_hash.
+    """
+    task_id = decision["task_id"]
+    generation = decision["claim_registry_generation"]
+    granted = decision["granted_claims"]
+    provenance = decision.get("provenance", {})
+    ref = f"StegVerse-Labs/.github@{source_commit}:"
+    record = {
+        "schema": CUSTODY_SCHEMA,
+        "custody_id": f"ORG-ALLOCATION-{task_id}-G{generation}-001",
+        "source": {
+            "task_id": task_id,
+            "repository": "StegVerse-Labs/.github",
+            "source_commit": source_commit,
+            "allocator_ref": ref + "scripts/allocate_claims.py",
+            "portable_allocator_ref": ref + "org_allocator/portable_allocator.js",
+            "task_ref": ref + f"tasks/{task_id}.json",
+            "claims_ref": ref + CLAIMS_REL.as_posix(),
+            "event_log_ref": ref + EVENTS_REL.as_posix(),
+        },
+        "transition": {
+            "transition_id": "ORG_CLAIMS_GRANTED",
+            "claim_registry_generation": generation,
+            "predecessor_generation": decision["recorded_generation"],
+            "receipt_sha256": decision["receipt_sha256"],
+            "execution_surface": decision.get("execution_surface"),
+            "queued_after_transition": decision.get("queued") or [],
+            "blocked_missing_dependency_declaration": decision.get(
+                "blocked_missing_dependency_declaration"
+            )
+            or [],
+        },
+        "claim": {
+            "task_id": task_id,
+            "fencing_tokens": decision["fencing_tokens"],
+            "repositories": sorted(
+                {
+                    str((claim.get("repository") or {}).get("full_name"))
+                    for claim in granted
+                    if (claim.get("repository") or {}).get("full_name")
+                }
+            ),
+            "dependency_surfaces": dependency_surfaces(granted),
+            "released": False,
+        },
+        "producing_surface": {
+            "node_id": provenance.get("node_id"),
+            "device_continuity_id": provenance.get("device_continuity_id"),
+            "execution_trigger": provenance.get("execution_trigger"),
+            "allocator_release": provenance.get("allocator_release"),
+            "journal_sequence": provenance.get("sequence"),
+            "journal_entry_sha256": provenance.get("entry_sha256"),
+            "executed_at": provenance.get("executed_at"),
+        },
+        "validation": {
+            "status": "PASS",
+            "validation_type": "CANONICAL_ALLOCATOR_RECEIPT_DIGEST_AND_GENERATION_CONTINUITY",
+            "receipt_digest_recomputed": True,
+            "claim_snapshot_digest_recomputed": bool(decision.get("observation_present")),
+            "generation_contiguous_with_recorded_state": True,
+            "runtime_execution_claimed": False,
+        },
+        "custody": {
+            "status": "ACCEPTED_FOR_CUSTODY",
+            "reconstruction_status": "PASS",
+            "authority_effect": "NONE",
+        },
+        "boundaries": [
+            "admission records a transition the canonical allocator already produced",
+            "admission does not allocate and does not grant claim authority",
+            "admission does not assert the claimed task executed or completed",
+            "a generation gap is denied rather than reconstructed",
+            "GitHub token is not a production runtime requirement",
+        ],
+        "github_token_required": False,
+        "authority_effect": "NONE",
+    }
+    record["record_hash"] = sha256_hex(record)
+    return record
+
+
+def apply_admission(root: Path, decision: Mapping[str, Any], *, source_commit: str) -> dict[str, Any]:
+    """Record an admitted transition at org level and in Master Records."""
+    task_id = decision["task_id"]
+    generation = decision["claim_registry_generation"]
+    granted = [dict(claim) for claim in decision["granted_claims"]]
+    stamp = occurred_at(decision)
+
+    claims_state = load_json(root / CLAIMS_REL)
+    active = list(claims_state.get("claims") or [])
+    held = {
+        (claim.get("task_id"), (claim.get("repository") or {}).get("full_name"))
+        for claim in active
+        if isinstance(claim, Mapping)
+    }
+    for claim in granted:
+        key = (claim.get("task_id"), (claim.get("repository") or {}).get("full_name"))
+        if key not in held:
+            active.append(claim)
+            held.add(key)
+    claims_state["claims"] = active
+    claims_state["generation"] = generation
+    claims_state["updated_at"] = stamp
+    dump_json(root / CLAIMS_REL, claims_state)
+
+    task_path = root / TASKS_REL / f"{task_id}.json"
+    task = load_json(task_path)
+    task["status"] = "active"
+    dump_json(task_path, task)
+
+    record = custody_record(decision, source_commit=source_commit)
+    custody_path = root / CUSTODY_REL / f"{record['custody_id']}.json"
+    dump_json(custody_path, record)
+
+    event = {
+        "event_id": f"ORG-EVENT-{generation + 1:06d}",
+        "event_type": "claims_granted",
+        "generation": generation,
+        "occurred_at": stamp,
+        "actor": "admitted_canonical_allocator_receipt",
+        "task_id": task_id,
+        "resources": [
+            (claim.get("repository") or {}).get("full_name")
+            for claim in granted
+            if (claim.get("repository") or {}).get("full_name")
+        ],
+        "dependency_surfaces": dependency_surfaces(granted),
+        "receipt_sha256": decision["receipt_sha256"],
+        "execution_surface": decision.get("execution_surface"),
+        "master_records_ref": custody_path.relative_to(root).as_posix(),
+        "master_records_record_hash": record["record_hash"],
+        "admission_grants_claim_authority": False,
+        "allocator_remains_claim_authority": True,
+        "github_token_runtime_authority": "NONE",
+    }
+    events_path = root / EVENTS_REL
+    events_path.parent.mkdir(parents=True, exist_ok=True)
+    with events_path.open("a", encoding="utf-8") as stream:
+        stream.write(json.dumps(event, sort_keys=True) + "\n")
+
+    return {
+        "schema": ADMISSION_SCHEMA,
+        "state": "ADMITTED",
+        "task_id": task_id,
+        "claim_registry_generation": generation,
+        "receipt_sha256": decision["receipt_sha256"],
+        "org_event_id": event["event_id"],
+        "master_records_ref": event["master_records_ref"],
+        "master_records_record_hash": record["record_hash"],
+        "admission_grants_claim_authority": False,
+        "allocator_remains_claim_authority": True,
+        "authority_effect": "NONE_RECORDING_ONLY",
+    }
+
+
+def admit_all(
+    root: Path, documents: list[Any], *, apply: bool, source_commit: str
+) -> dict[str, Any]:
+    """Evaluate receipts in generation order, stopping at the first denial.
+
+    Ordering by generation lets a recovered journal be replayed in one call,
+    and stopping on denial keeps a gap from being stepped over silently.
+    """
+
+    def generation_of(document: Any) -> int:
+        try:
+            return int(extract(document)["receipt"].get("claim_registry_generation") or 0)
+        except Exception:
+            return 0
+
+    results: list[dict[str, Any]] = []
+    state = "NO_RECEIPTS"
+    for document in sorted(documents, key=generation_of):
+        decision = evaluate(root, document)
+        if decision["decision"] == "ADMIT":
+            if apply:
+                results.append(apply_admission(root, decision, source_commit=source_commit))
+            else:
+                results.append({**decision, "state": "ADMISSIBLE_DRY_RUN"})
+            state = "ADMISSION_COMPLETE"
+            continue
+        if decision["decision"] == "ALREADY_ADMITTED":
+            results.append({**decision, "state": "ALREADY_ADMITTED"})
+            continue
+        results.append({**decision, "state": "DENIED"})
+        state = "DENIED"
+        break
+    return {
+        "schema": ADMISSION_SCHEMA,
+        "state": state,
+        "applied": bool(apply),
+        "recorded_generation": recorded_generation(root),
+        "results": results,
+        "admission_grants_claim_authority": False,
+        "allocator_remains_claim_authority": True,
+        "credential_authority": "TV/TVC",
+        "github_token_runtime_authority": "NONE",
+        "authority_effect": "NONE_RECORDING_ONLY",
+    }
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(
+        description="Admit canonical organization allocator transition receipts."
+    )
+    parser.add_argument("receipts", nargs="+", help="receipt, journal entry or evidence JSON files")
+    parser.add_argument("--root", type=Path, default=ROOT)
+    parser.add_argument(
+        "--apply",
+        action="store_true",
+        help="record admitted transitions; without it the run is a decision preview",
+    )
+    parser.add_argument(
+        "--source-commit",
+        default="UNPINNED",
+        help="commit the admitted record cites as its source revision",
+    )
+    args = parser.parse_args()
+
+    documents = [load_json(Path(path)) for path in args.receipts]
+    try:
+        result = admit_all(
+            args.root.resolve(),
+            documents,
+            apply=args.apply,
+            source_commit=args.source_commit,
+        )
+    except Exception as exc:  # fail closed, never partially report success
+        print(json.dumps({"schema": ADMISSION_SCHEMA, "state": "BLOCKED", "reason": str(exc)}, sort_keys=True))
+        return 2
+    print(json.dumps(result, indent=2, sort_keys=True))
+    return 0 if result["state"] in {"ADMISSION_COMPLETE", "ALREADY_ADMITTED", "NO_RECEIPTS"} else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
