+class HeartbeatLaneRestored(SandboxRoot):
+    """Admission is what gives the organization heartbeat something to assert.
+
+    All 26 ``organization_assertions_issued`` events in the repository carry
+    ``issued_count: 0`` because the claim registry is empty. These tests pin
+    that cause and its removal.
+    """
+
+    def setUp(self) -> None:
+        super().setUp()
+        shutil.copytree(ROOT / "heartbeats", self.tmp / "heartbeats", dirs_exist_ok=True)
+
+    def test_no_claims_means_no_assertions(self) -> None:
+        issued = issue_claim_assertions(
+            self.tmp, epoch=30, issued_at="2026-09-22T00:00:00Z", write=False
+        )
+        self.assertEqual(issued, [])
+
+    def test_admission_restores_assertion_issuance(self) -> None:
+        admitter.admit_all(
+            self.tmp, [synth_receipt(self.task_id, 3)], apply=True, source_commit="TEST"
+        )
+        issued = issue_claim_assertions(
+            self.tmp, epoch=30, issued_at="2026-09-22T00:00:00Z", write=True
+        )
+        self.assertEqual(len(issued), 1)
+        assertion = json.loads(
+            (self.tmp / issued[0]).read_text(encoding="utf-8")
+        )
+        self.assertEqual(assertion["claimant_id"], self.task_id)
+        self.assertEqual(assertion["fencing_token"], 3)
+        self.assertEqual(assertion["authority_effect"], "none")
+
+
+if __name__ == "__main__":
+    unittest.main()
