+"""Organization-level admission of canonical allocator transition receipts.
+
+The lane these tests cover is the one that was missing: a transition the
+canonical allocator already computed on some surface becomes recorded
+organization state, and only then does the heartbeat have anything to assert
+about.
+"""
+
+from __future__ import annotations
+
+import json
+import shutil
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+if str(ROOT) not in sys.path:
+    sys.path.insert(0, str(ROOT))
+
+import importlib.util
+
+_SPEC = importlib.util.spec_from_file_location(
+    "admit_org_allocator_transition_receipt",
+    ROOT / "scripts" / "admit_org_allocator_transition_receipt.py",
+)
+admitter = importlib.util.module_from_spec(_SPEC)
+sys.modules[_SPEC.name] = admitter
+_SPEC.loader.exec_module(admitter)
+
+from heartbeat_runtime.org_assertions import issue_claim_assertions
+
+DEVICE_EVIDENCE = (
+    ROOT
+    / "evidence"
+    / "global-runtime-evidence-closure-001"
+    / "original"
+    / "stegverse-org-allocator-TASK-2026-0011-G7-v2.json"
+)
+
+
+def seal(body: dict) -> dict:
+    """Stamp a receipt the way org_allocator/portable_allocator.js does."""
+    receipt = {key: value for key, value in body.items() if key != "receipt_sha256"}
+    receipt["receipt_sha256"] = "sha256:" + admitter.sha256_hex(receipt)
+    return receipt
+
+
+def synth_receipt(task_id: str, generation: int, *, repository: str = "StegVerse-Labs/Site") -> dict:
+    claim = {
+        "task_id": task_id,
+        "mode": "scoped_exclusive",
+        "preemptible": True,
+        "repository": {
+            "host": "github.com",
+            "owner": repository.split("/")[0],
+            "name": repository.split("/")[1],
+            "full_name": repository,
+            "default_branch": "main",
+        },
+        "scope": {
+            "paths": ["docs/EXAMPLE.md"],
+            "contracts": [],
+            "release_surfaces": [],
+            "capabilities": [],
+            "workflows": [],
+            "dependency_surfaces": ["site:example-surface"],
+        },
+        "lease": {
+            "expires_at": "2026-09-23T00:00:00Z",
+            "heartbeat_due_at": "2026-09-22T08:00:00Z",
+            "fencing_token": generation,
+            "service_class": "low_contention",
+        },
+    }
+    return seal(
+        {
+            "schema": admitter.RECEIPT_SCHEMA,
+            "state": "ALLOCATION_COMPLETE",
+            "selected": task_id,
+            "queued": [task_id],
+            "blocked_missing_dependency_declaration": [],
+            "claim_registry_generation": generation,
+            "granted_claims": [claim],
+            "execution_surface": "CURRENT_USER_IPHONE",
+            "canonical_authority_owner": "StegVerse-Labs/.github organization allocator",
+            "credential_authority": "TV/TVC",
+            "heartbeat_grants_claim_authority": False,
+            "request_grants_claim_authority": False,
+            "stegos_grants_claim_authority": False,
+            "github_token_runtime_authority": "NONE",
+            "network_source_fetch_performed": False,
+            "requires_other_machine": False,
+            "second_user_operated_device_required": False,
+            "authority_effect": "CLAIM_AUTHORITY_ONLY_WHEN_SELECTED_BY_CANONICAL_ALLOCATOR",
+        }
+    )
+
+
+class SandboxRoot(unittest.TestCase):
+    """A disposable organization control plane at the repository's own state."""
+
+    def setUp(self) -> None:
+        self.tmp = Path(tempfile.mkdtemp())
+        self.addCleanup(shutil.rmtree, self.tmp, True)
+        for relative in ("control", "tasks", "events"):
+            shutil.copytree(ROOT / relative, self.tmp / relative)
+        self.task_id = "TASK-2026-0007"
+
+    def events(self) -> list[dict]:
+        text = (self.tmp / admitter.EVENTS_REL).read_text(encoding="utf-8")
+        return [json.loads(line) for line in text.splitlines() if line.strip()]
+
+    def claims(self) -> dict:
+        return json.loads((self.tmp / admitter.CLAIMS_REL).read_text(encoding="utf-8"))
+
+
+class DeviceReceiptIntegrity(unittest.TestCase):
+    def test_recorded_device_receipt_digests_recompute(self) -> None:
+        """The receipt the user's device produced verifies outside the device."""
+        document = json.loads(DEVICE_EVIDENCE.read_text(encoding="utf-8"))
+        parts = admitter.extract(document)
+        receipt = parts["receipt"]
+        body = {k: v for k, v in receipt.items() if k != "receipt_sha256"}
+        self.assertEqual("sha256:" + admitter.sha256_hex(body), receipt["receipt_sha256"])
+
+        observation = parts["observation"]
+        snapshot = {
+            "task_id": observation["task_id"],
+            "claim_registry_generation": observation["claim_registry_generation"],
+            "claims": observation["claims"],
+        }
+        self.assertEqual(
+            admitter.sha256_hex(snapshot), observation["claim_snapshot_sha256"]
+        )
+
+    def test_device_provenance_is_carried_through(self) -> None:
+        document = json.loads(DEVICE_EVIDENCE.read_text(encoding="utf-8"))
+        provenance = admitter.extract(document)["provenance"]
+        self.assertEqual(provenance["execution_surface"], "CURRENT_USER_IPHONE")
+        self.assertTrue(str(provenance["node_id"]).startswith("stegnode-web-"))
+        self.assertTrue(str(provenance["device_continuity_id"]).startswith("stegdevice-"))
+        self.assertEqual(provenance["sequence"], 67)
+
+
+class GenerationContinuity(SandboxRoot):
+    def test_recorded_state_is_behind_the_device(self) -> None:
+        """The condition this module exists to detect."""
+        self.assertEqual(admitter.recorded_generation(self.tmp), 2)
+        self.assertEqual(self.claims()["claims"], [])
+
+    def test_generation_gap_is_denied_and_names_what_is_missing(self) -> None:
+        document = json.loads(DEVICE_EVIDENCE.read_text(encoding="utf-8"))
+        decision = admitter.evaluate(self.tmp, document)
+        self.assertEqual(decision["decision"], "DENY")
+        self.assertEqual(decision["deny_reason"], "GENERATION_GAP")
+        self.assertEqual(decision["missing_generations"], [3, 4, 5, 6])
+
+    def test_stale_generation_is_denied(self) -> None:
+        decision = admitter.evaluate(self.tmp, synth_receipt(self.task_id, 2))
+        self.assertEqual(decision["deny_reason"], "GENERATION_NOT_MONOTONIC")
+
+    def test_replay_stops_at_the_first_gap(self) -> None:
+        """A gap is never stepped over, even with a later receipt in hand."""
+        result = admitter.admit_all(
+            self.tmp,
+            [synth_receipt(self.task_id, 5), synth_receipt(self.task_id, 3)],
+            apply=True,
+            source_commit="TEST",
+        )
+        self.assertEqual(result["state"], "DENIED")
+        self.assertEqual([entry["state"] for entry in result["results"]], ["ADMITTED", "DENIED"])
+        self.assertEqual(result["results"][1]["missing_generations"], [4])
+
+
+class Admission(SandboxRoot):
+    def test_contiguous_receipt_is_recorded_at_org_and_master_records(self) -> None:
+        before = len(self.events())
+        result = admitter.admit_all(
+            self.tmp, [synth_receipt(self.task_id, 3)], apply=True, source_commit="TESTCOMMIT"
+        )
+        self.assertEqual(result["state"], "ADMISSION_COMPLETE")
+
+        events = self.events()
+        self.assertEqual(len(events), before + 1)
+        event = events[-1]
+        self.assertEqual(event["event_type"], "claims_granted")
+        self.assertEqual(event["generation"], 3)
+        self.assertEqual(event["task_id"], self.task_id)
+        self.assertIs(event["admission_grants_claim_authority"], False)
+        self.assertIs(event["allocator_remains_claim_authority"], True)
+
+        claims = self.claims()
+        self.assertEqual(claims["generation"], 3)
+        self.assertEqual([claim["task_id"] for claim in claims["claims"]], [self.task_id])
+
+        record_path = self.tmp / event["master_records_ref"]
+        self.assertTrue(record_path.is_file())
+        record = json.loads(record_path.read_text(encoding="utf-8"))
+        self.assertEqual(record["schema"], admitter.CUSTODY_SCHEMA)
+        self.assertEqual(record["transition"]["transition_id"], "ORG_CLAIMS_GRANTED")
+        self.assertEqual(record["validation"]["status"], "PASS")
+        self.assertIs(record["validation"]["runtime_execution_claimed"], False)
+        self.assertEqual(record["authority_effect"], "NONE")
+
+        body = {k: v for k, v in record.items() if k != "record_hash"}
+        self.assertEqual(admitter.sha256_hex(body), record["record_hash"])
+        self.assertEqual(event["master_records_record_hash"], record["record_hash"])
+
+        task = json.loads((self.tmp / "tasks" / f"{self.task_id}.json").read_text(encoding="utf-8"))
+        self.assertEqual(task["status"], "active")
+
+    def test_admission_is_idempotent(self) -> None:
+        receipt = synth_receipt(self.task_id, 3)
+        admitter.admit_all(self.tmp, [receipt], apply=True, source_commit="TEST")
+        after_first = len(self.events())
+        second = admitter.admit_all(self.tmp, [receipt], apply=True, source_commit="TEST")
+        self.assertEqual(second["results"][0]["state"], "ALREADY_ADMITTED")
+        self.assertEqual(len(self.events()), after_first)
+
+    def test_dry_run_records_nothing(self) -> None:
+        before = (self.tmp / admitter.EVENTS_REL).read_bytes()
+        result = admitter.admit_all(
+            self.tmp, [synth_receipt(self.task_id, 3)], apply=False, source_commit="TEST"
+        )
+        self.assertEqual(result["results"][0]["state"], "ADMISSIBLE_DRY_RUN")
+        self.assertEqual((self.tmp / admitter.EVENTS_REL).read_bytes(), before)
+        self.assertEqual(self.claims()["generation"], 2)
+
+
+class FailClosed(SandboxRoot):
+    def test_tampered_receipt_is_denied(self) -> None:
+        receipt = synth_receipt(self.task_id, 3)
+        receipt["queued"] = ["TASK-FABRICATED"]
+        decision = admitter.evaluate(self.tmp, receipt)
+        self.assertEqual(decision["deny_reason"], "RECEIPT_DIGEST_MISMATCH")
+
+    def test_governance_assertion_violation_is_denied_even_when_resealed(self) -> None:
+        body = synth_receipt(self.task_id, 3)
+        body["github_token_runtime_authority"] = "PRODUCTION"
+        decision = admitter.evaluate(self.tmp, seal(body))
+        self.assertEqual(decision["deny_reason"], "GOVERNANCE_ASSERTION_MISMATCH")
+        self.assertEqual(decision["field"], "github_token_runtime_authority")
+
+    def test_secret_bearing_field_is_denied_even_when_resealed(self) -> None:
+        body = synth_receipt(self.task_id, 3)
+        body["granted_claims"][0]["client_secret"] = "hunter2"
+        decision = admitter.evaluate(self.tmp, seal(body))
+        self.assertEqual(decision["deny_reason"], "SECRET_BEARING_FIELD")
+        self.assertIn("client_secret", decision["field_path"])
+
+    def test_governance_assertion_fields_are_not_mistaken_for_secrets(self) -> None:
+        """The fields that prove no credential is present must not be refused."""
+        decision = admitter.evaluate(self.tmp, synth_receipt(self.task_id, 3))
+        self.assertEqual(decision["decision"], "ADMIT")
+
+    def test_fence_must_agree_with_generation(self) -> None:
+        body = synth_receipt(self.task_id, 3)
+        body["granted_claims"][0]["lease"]["fencing_token"] = 99
+        decision = admitter.evaluate(self.tmp, seal(body))
+        self.assertEqual(decision["deny_reason"], "RECEIPT_FENCE_GENERATION_DISAGREE")
+
+    def test_claim_snapshot_digest_must_match_when_observation_present(self) -> None:
+        receipt = synth_receipt(self.task_id, 3)
+        document = {
+            "wrapper": receipt,
+            "claim_observation": {
+                "schema": admitter.OBSERVATION_SCHEMA,
+                "task_id": self.task_id,
+                "claim_registry_generation": 3,
+                "claims": receipt["granted_claims"],
+                "claim_snapshot_sha256": "0" * 64,
+            },
+        }
+        decision = admitter.evaluate(self.tmp, document)
+        self.assertEqual(decision["deny_reason"], "CLAIM_SNAPSHOT_DIGEST_MISMATCH")
+
+    def test_unknown_task_is_denied(self) -> None:
+        decision = admitter.evaluate(self.tmp, synth_receipt("TASK-DOES-NOT-EXIST", 3))
+        self.assertEqual(decision["deny_reason"], "TASK_NOT_IN_CATALOG")
+
+    def test_receipt_without_a_selection_is_denied(self) -> None:
+        body = synth_receipt(self.task_id, 3)
+        body["selected"] = None
+        self.assertEqual(
+            admitter.evaluate(self.tmp, seal(body))["deny_reason"], "RECEIPT_SELECTED_NO_TASK"
+        )
+
